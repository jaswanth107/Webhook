{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'static dashboard - nothing to build'",
  "installCommand": "echo 'no dependencies - public/ is plain HTML, CSS and JS'",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://webhook-fortress-sh4v.onrender.com/health"
    },
    {
      "source": "/metrics",
      "destination": "https://webhook-fortress-sh4v.onrender.com/metrics"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://webhook-fortress-sh4v.onrender.com/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
