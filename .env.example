# ---- Database ---------------------------------------------------------------
# Host-side default (docker compose exposes Postgres on 5433 to avoid clashing
# with a local Postgres on 5432). Inside the compose network the receiver uses
# postgres://fortress:fortress@db:5432/webhook_fortress (set in docker-compose.yml).
DATABASE_URL=postgres://fortress:fortress@localhost:5433/webhook_fortress

# ---- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ---- Security ---------------------------------------------------------------
# Shared secret used for HMAC-SHA256 over the raw request body.
WEBHOOK_SECRET=super-secret-webhook-key-change-me
SIGNATURE_HEADER=x-webhook-signature

# ---- Retry / processing -----------------------------------------------------
MAX_PROCESSING_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
RETRY_JITTER_RATIO=0.2
PROCESSING_TIMEOUT_SECONDS=30

# ---- Worker -----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=10
# Single-instance deployments reclaim every PROCESSING row on boot (fast crash
# recovery). Set to false when running multiple receivers and rely on the
# PROCESSING_TIMEOUT_SECONDS lease instead.
RECOVER_ALL_PROCESSING_ON_START=true
PG_POOL_MAX=20

# ---- Chaos / testing (never enable in production) ---------------------------
# Both are ON here because this repository's docker compose stack IS the
# hostility-test environment: SIMULATE_FAILURES activates the deterministic
# failure handlers driven by the event payload, and CHAOS_ENABLED exposes
# POST /admin/chaos/crash + /admin/chaos/reset. Set both to false for a real
# deployment -- the receiver then has no way to be crashed or reset remotely.
SIMULATE_FAILURES=true
CHAOS_ENABLED=true
# Hard-kills the receiver when this eventId is processed.
SIMULATE_CRASH_EVENT=
SIMULATE_CRASH_POINT=after_business_effect_before_commit
